# .env.example — plantilla de variables de entorno del backend
# Copiala a backend/.env y rellena solo lo que uses. NUNCA commitear .env real.

# --- Aplicacion ---
# Nivel de log: debug | info | warning | error
LOG_LEVEL=info

# --- Ingesta ---
MAX_UPLOAD_MB=25
MAX_SHEETS=50
MAX_ROWS=100000

# --- IA (plan: por defecto none; el chat llega en F2) ---
# none | gemini | anthropic | openai_compatible | ollama
AI_PROVIDER=none
# Obligatorio para activar IA (no hay modelo fijado en codigo)
AI_MODEL=
# Solo para openai_compatible / ollama
AI_BASE_URL=
# Claves: solo en .env, nunca en el frontend ni en el repo
AI_API_KEY=
# Temperatura baja por anti-alucinacion
AI_TEMPERATURE=0.1
